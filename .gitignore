# Python
__pycache__/
*.pyc
*.pyo

# Runtime state (generated by tools, not source code)
journal/trades.csv
peak_equity.txt
sod_equity.txt
alerts.json

# Secrets — NEVER commit real tokens
.env

# OS
Thumbs.db
.DS_Store
nul
# лог сборки не версионируется
*.compile.log

# .ex5 публикуется ОСОЗНАННО и только пересобранным из опубликованного
# исходника — иначе бинарник и код разойдутся, и тот, кто возьмёт .ex5,
# будет гонять не тот советник, который читает. Проверка перед каждым
# обновлением: пересобрать из src и убедиться, что компиляция 0 ошибок.
!EA/*.ex5
