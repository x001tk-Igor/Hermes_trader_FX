# XAU AI Trader — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# Telegram bot for notifications (optional, but recommended)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_PROXY=http://127.0.0.1:PROXY_PORT

# MT5 terminal path (Windows default for RoboForex)
MT5_TERMINAL_PATH=C:\Program Files\RoboForex MT5 Terminal\terminal64.exe

# Account
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_SERVER=RoboForex-Pro